---
// Editor de texto sencillo (negrita, títulos, listas, enlaces) con vista de código HTML.
interface Props { nombre: string; valor?: string; etiqueta: string; requerido?: boolean; ayuda?: string }
const { nombre, valor = '', etiqueta, requerido = false, ayuda } = Astro.props;
const id = `editor-${nombre}`;
---
<div class="campo campo--ancho">
  <span class="etiqueta-campo" id={`${id}-etiqueta`}>{etiqueta} {requerido && <span class="req">*</span>}</span>
  {ayuda && <small>{ayuda}</small>}
  <div class="editor" data-editor={nombre} data-requerido={requerido ? '1' : undefined}>
    <div class="editor__barra" role="toolbar" aria-label="Formato de texto">
      <button type="button" data-cmd="bold" title="Negrita"><b>B</b></button>
      <button type="button" data-cmd="italic" title="Cursiva"><i>I</i></button>
      <span class="sep"></span>
      <button type="button" data-cmd="formatBlock" data-valor="h2" title="Subtítulo grande">H2</button>
      <button type="button" data-cmd="formatBlock" data-valor="h3" title="Subtítulo pequeño">H3</button>
      <button type="button" data-cmd="formatBlock" data-valor="p" title="Párrafo normal">¶</button>
      <span class="sep"></span>
      <button type="button" data-cmd="insertUnorderedList" title="Lista con viñetas">• Lista</button>
      <button type="button" data-cmd="insertOrderedList" title="Lista numerada">1. Lista</button>
      <span class="sep"></span>
      <button type="button" data-cmd="createLink" title="Agregar enlace">Enlace</button>
      <button type="button" data-cmd="unlink" title="Quitar enlace">Quitar enlace</button>
      <button type="button" class="modo" data-modo title="Ver o editar el código HTML">&lt;/&gt; Código</button>
    </div>
    <div class="editor__area" contenteditable="true" role="textbox" aria-multiline="true" aria-labelledby={`${id}-etiqueta`} data-placeholder="Escribe aquí…" set:html={valor}></div>
    <textarea class="editor__codigo" aria-label={`${etiqueta} (código HTML)`} spellcheck="false"></textarea>
  </div>
</div>
