---
import Detalle from '../../components/Detalle.astro';
import { getDB, getItem } from '../../lib/datos';

const item = await getItem(getDB(Astro.locals), 'cocinas', Astro.params.slug ?? '');
if (!item) return Astro.rewrite('/404');
---
<Detalle item={item} volver={{ texto: 'Cocinas integrales', href: '/concinas-integrales/' }} />
