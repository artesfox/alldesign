---
import Detalle from '../../components/Detalle.astro';
import { getDB, getItem } from '../../lib/datos';

const item = await getItem(getDB(Astro.locals), 'productos', Astro.params.slug ?? '');
if (!item) return Astro.rewrite('/404');
---
<Detalle item={item} volver={{ texto: 'Otros productos', href: '/productos/' }} />
