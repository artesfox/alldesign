---
import Panel from '../../../layouts/Panel.astro';
import { esTipo, getCatalogo, getDB, img, instalada, pesos, porcentaje, TIPOS } from '../../../lib/datos';

const { tipo } = Astro.params;
if (!esTipo(tipo)) return Astro.redirect('/admin');
const db = getDB(Astro.locals);
if (!(await instalada(db))) return Astro.redirect('/admin');
const items = await getCatalogo(db, tipo, true);
const info = TIPOS[tipo];
---
<Panel titulo={info.plural} seccion={tipo}>
  <div class="cabecera-lista">
    <input class="entrada buscador" type="search" placeholder={`Buscar ${info.plural.toLowerCase()}…`} data-buscar aria-label="Buscar" />
    <a class="btn btn--primario" href={`/admin/${tipo}/nuevo`}>+ Nueva {info.singular}</a>
  </div>

  <div class="tarjeta">
    {items.length === 0 ? (
      <p class="vacio">Todavía no hay {info.plural.toLowerCase()}. <a href={`/admin/${tipo}/nuevo`}>Crea la primera</a>.</p>
    ) : (
      <ul class="lista">
        {items.map((it) => (
          <li class="fila" data-fila data-texto={it.titulo.toLowerCase()}>
            <img class="fila__foto" src={img(it.portada, true)} alt="" loading="lazy" />
            <div class="fila__datos">
              <a class="fila__titulo" href={`/admin/${tipo}/${it.id}`}>{it.titulo}</a>
              <div class="fila__meta">
                <span>{it.galeria.length} foto{it.galeria.length === 1 ? '' : 's'}</span>
                {tipo === 'promociones' && <span>{pesos(it.precioDescuento)}</span>}
                {tipo === 'promociones' && porcentaje(it.precio, it.precioDescuento) > 0 && <span class="etiqueta etiqueta--oferta">-{porcentaje(it.precio, it.precioDescuento)}%</span>}
                {!it.publicado && <span class="etiqueta etiqueta--borrador">Borrador</span>}
              </div>
            </div>
            <div class="fila__acciones">
              <a class="btn btn--suave btn--icono" href={`${info.ruta}${it.slug}/`} target="_blank" rel="noopener" title="Ver en la web" aria-label="Ver en la web">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" /><circle cx="12" cy="12" r="3" /></svg>
              </a>
              <a class="btn btn--suave" href={`/admin/${tipo}/${it.id}`}>Editar</a>
              <button type="button" class="btn btn--peligro" data-borrar={`/api/admin/catalogo/${it.id}`} data-nombre={it.titulo}>Borrar</button>
            </div>
          </li>
        ))}
      </ul>
    )}
  </div>
</Panel>
