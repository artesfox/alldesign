---
import Panel from '../../layouts/Panel.astro';
import { getConteos, getDB, instalada, TIPOS } from '../../lib/datos';

const db = getDB(Astro.locals);
const lista = await instalada(db);
const c = lista ? await getConteos(db) : null;
const env = Astro.locals.runtime.env;
const sinFotos = !env.FOTOS;

const tarjetas = [
  { id: 'cocinas', nombre: TIPOS.cocinas.plural, icono: 'M4 4h16v7H4zM4 11v9h16v-9M9 15h6' },
  { id: 'promociones', nombre: TIPOS.promociones.plural, icono: 'M20 12l-8 8-9-9V3h8l9 9zM7.5 7.5h.01' },
  { id: 'productos', nombre: TIPOS.productos.plural, icono: 'M3 7l9-4 9 4-9 4-9-4zm0 0v10l9 4 9-4V7' },
  { id: 'entradas', nombre: 'Entradas del blog', icono: 'M5 4h11l3 3v13H5zM9 9h6M9 13h6M9 17h4' },
] as const;
const hora = new Date().toLocaleString('en-US', { timeZone: 'America/Bogota', hour: 'numeric', hour12: false });
const saludo = Number(hora) < 12 ? 'Buenos días' : Number(hora) < 19 ? 'Buenas tardes' : 'Buenas noches';
---
<Panel titulo="Resumen" seccion="resumen">
  <div class="saludo">
    <h2>{saludo} 👋</h2>
    <p>Desde aquí actualizas todo el contenido de alldesign.com.co.</p>
  </div>

  {sinFotos && (
    <div class="alerta alerta--aviso">Falta conectar el almacenamiento de fotos (R2) con el nombre <b>FOTOS</b>. Mientras tanto no se pueden subir fotos nuevas.</div>
  )}

  {!lista ? (
    <section class="tarjeta bloque">
      <h2 class="bloque__titulo">Instalar la base de datos</h2>
      <p class="bloque__ayuda">Es el primer paso y solo se hace una vez: se crean las tablas y se copia todo el contenido actual (cocinas, productos, promociones, blog e información del inicio).</p>
      <button type="button" class="btn btn--primario btn--grande" data-instalar>Instalar base de datos</button>
    </section>
  ) : (
    <>
      <div class="contadores">
        {tarjetas.map((t) => (
          <a class="tarjeta contador" href={`/admin/${t.id}`}>
            <div class="contador__cabeza">
              <span class="contador__numero">{c?.[t.id] ?? 0}</span>
              <span class="contador__icono"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={t.icono} /></svg></span>
            </div>
            <div>
              <div class="contador__nombre">{t.nombre}</div>
              <div class="contador__accion">Administrar →</div>
            </div>
          </a>
        ))}
      </div>

      <h2 class="bloque__titulo" style="margin-bottom:12px">Acciones rápidas</h2>
      <div class="atajos">
        <a class="tarjeta atajo" href="/admin/cocinas/nuevo"><span>+</span> Nueva cocina</a>
        <a class="tarjeta atajo" href="/admin/promociones/nuevo"><span>+</span> Nueva promoción</a>
        <a class="tarjeta atajo" href="/admin/productos/nuevo"><span>+</span> Nuevo producto</a>
        <a class="tarjeta atajo" href="/admin/entradas/nuevo"><span>+</span> Nueva entrada</a>
        <a class="tarjeta atajo" href="/admin/inicio"><span>✎</span> Editar inicio e información</a>
      </div>
    </>
  )}
</Panel>
