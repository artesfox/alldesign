---
import Detalle from '../../components/Detalle.astro';
import { getDB, getItem } from '../../lib/datos';

const item = await getItem(getDB(Astro.locals), 'promociones', Astro.params.slug ?? '');
if (!item) return Astro.rewrite('/404');
---
<Detalle item={item} volver={{ texto: 'Promociones', href: '/promociones/' }} boton="Solicitar información" />
