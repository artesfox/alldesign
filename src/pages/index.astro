---
import Base from '../layouts/Base.astro';
import CarruselInicio from '../components/CarruselInicio.astro';
import { getSitio, textoPlano } from '../lib/datos';

const sitio = await getSitio();
---
<Base titulo="All Design Cocinas Integrales" descripcion={textoPlano(sitio.descripcion)} imagen={`/uploads/${sitio.galeriaInicio[0]?.imagen}`} galerias>
  <section class="seccion seccion--inicio">
    <div class="contenedor">
      <CarruselInicio fotos={sitio.galeriaInicio} />
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor contenedor--texto">
      <h1 class="titulo-centrado">{sitio.titulo}</h1>
      <div class="texto descipcion_corta" tabindex="0" set:html={sitio.descripcion} />
    </div>
  </section>
</Base>
