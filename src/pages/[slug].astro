---
// Entradas del blog. Viven en la raíz (/nombre-de-la-entrada/) igual que en WordPress,
// para no perder el posicionamiento en Google.
import Base from '../layouts/Base.astro';
import TarjetaBlog from '../components/TarjetaBlog.astro';
import { fechaCorta, getEntradas, img, type Entrada } from '../lib/datos';

export async function getStaticPaths() {
  const entradas = await getEntradas();
  return entradas.map((entrada, i) => ({
    params: { slug: entrada.slug },
    props: { entrada, relacionadas: [...entradas.slice(i + 1), ...entradas.slice(0, i)].slice(0, 3) },
  }));
}
const { entrada, relacionadas } = Astro.props as { entrada: Entrada; relacionadas: Entrada[] };
---
<Base titulo={entrada.titulo} descripcion={entrada.extracto} imagen={img(entrada.imagen)}>
  <article class="seccion">
    <div class="contenedor contenedor--texto articulo">
      <a href="/blog/" class="detalle__volver">← Blog</a>
      <h1>{entrada.titulo}</h1>
      <time class="entrada__fecha" datetime={entrada.fecha}>{fechaCorta(entrada.fecha)}</time>
      <img class="articulo__imagen" src={img(entrada.imagen)} alt={entrada.titulo} loading="eager" decoding="async" />
      <div class="texto" set:html={entrada.contenido} />
    </div>
  </article>

  <section class="seccion seccion--gris">
    <div class="contenedor">
      <h2 class="titulo-centrado">Entradas relacionadas</h2>
      <div class="grilla grilla--blog">
        {relacionadas.map((e) => <TarjetaBlog entrada={e} />)}
      </div>
    </div>
  </section>
</Base>
