---
// Contacto. En la etapa 1 el formulario arma el mensaje y lo abre en WhatsApp
// (no necesita servidor). En la etapa 2 se podrá enviar también por correo.
import Base from '../layouts/Base.astro';
import { getSitio } from '../lib/datos';

const sitio = await getSitio();
const numero = sitio.celular1.replace(/\D/g, '');
---
<Base titulo="Contacto" descripcion="Contáctanos para cotizar tu cocina integral, closet o mueble a la medida en Bogotá. All Design Cocinas Integrales.">
  <section class="seccion">
    <div class="contenedor contacto">
      <div class="contacto__info">
        <h1>Contacto</h1>
        <p>Cuéntanos qué necesitas y te ayudamos a diseñar el espacio que sueñas. Te respondemos por WhatsApp.</p>
        <ul class="contacto__datos">
          {sitio.celular1 && <li><strong>Celular:</strong> <a href={`tel:+57${numero}`}>{sitio.celular1}</a></li>}
          {sitio.telefonoFijo && <li><strong>Teléfono fijo:</strong> <a href={`tel:${sitio.telefonoFijo.replace(/\D/g, '')}`}>{sitio.telefonoFijo}</a></li>}
          {sitio.celular2 && <li><strong>Celular:</strong> <a href={`tel:+57${sitio.celular2.replace(/\D/g, '')}`}>{sitio.celular2}</a></li>}
          <li><strong>Correo:</strong> <a href={`mailto:${sitio.correo}`}>{sitio.correo}</a></li>
          {sitio.redes.google && <li><strong>Ubicación:</strong> <a href={sitio.redes.google} target="_blank" rel="noopener">Ver en Google Maps</a></li>}
        </ul>
      </div>

      <form class="formulario" data-formulario-whatsapp={numero}>
        <label>Nombre<input name="nombre" type="text" autocomplete="name" required /></label>
        <label>Teléfono<input name="telefono" type="tel" autocomplete="tel" required /></label>
        <label>Correo electrónico<input name="correo" type="email" autocomplete="email" /></label>
        <label>Mensaje<textarea name="mensaje" rows="6" required></textarea></label>
        <button class="boton boton--ancho" type="submit">Enviar por WhatsApp</button>
      </form>
    </div>
  </section>
</Base>
