---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getDB, getSitio, whatsapp } from '../lib/datos';

interface Props {
  titulo: string;
  descripcion?: string;
  imagen?: string;          // ruta pública para compartir en redes
  galerias?: boolean;       // carga Swiper + lightbox solo donde se necesita
}
const { titulo, descripcion = '', imagen = '/img/logo-all-design.svg', galerias = false } = Astro.props;
const sitio = await getSitio(getDB(Astro.locals));
const nombreSitio = 'All Design Cocinas Integrales';
const tituloCompleto = titulo === nombreSitio ? `${nombreSitio} | Cocinas integrales Bogotá` : `${titulo} | ${nombreSitio}`;
const canonica = new URL(Astro.url.pathname, Astro.site);
const urlWhatsapp = whatsapp(sitio.celular1, `Hola! Deseo información ${canonica.href}`);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    {descripcion && <meta name="description" content={descripcion} />}
    <link rel="canonical" href={canonica.href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={tituloCompleto} />
    {descripcion && <meta property="og:description" content={descripcion} />}
    <meta property="og:image" content={new URL(imagen, Astro.site).href} />
    <meta property="og:locale" content="es_CO" />
    <meta name="theme-color" content="#e01717" />
    <link rel="icon" href="/img/cropped-ico-all-design-cocinas-32x32.png" type="image/png" sizes="32x32" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" />
    {galerias && <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11.1.14/swiper-bundle.min.css" />}
  </head>
  <body>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer sitio={sitio} />

    <a class="whatsapp-flotante" href={urlWhatsapp} target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">
      <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16.04 3C8.86 3 3.03 8.82 3.03 16c0 2.3.6 4.53 1.74 6.5L3 29l6.68-1.75A12.9 12.9 0 0 0 16.04 29C23.2 29 29 23.18 29 16S23.2 3 16.04 3Zm0 23.6c-2 0-3.96-.54-5.67-1.55l-.4-.24-3.97 1.04 1.06-3.86-.26-.4A10.56 10.56 0 0 1 5.4 16c0-5.86 4.77-10.62 10.64-10.62 5.86 0 10.6 4.76 10.6 10.62 0 5.86-4.74 10.6-10.6 10.6Zm5.82-7.94c-.32-.16-1.9-.94-2.19-1.04-.3-.11-.5-.16-.72.16-.21.32-.82 1.04-1 1.25-.19.21-.37.24-.69.08-.32-.16-1.35-.5-2.57-1.59-.95-.85-1.6-1.9-1.78-2.22-.19-.32-.02-.49.14-.65.14-.14.32-.37.48-.56.16-.19.21-.32.32-.53.1-.21.05-.4-.03-.56-.08-.16-.72-1.73-.98-2.37-.26-.62-.52-.54-.72-.55h-.61c-.21 0-.56.08-.85.4-.29.32-1.12 1.09-1.12 2.66s1.14 3.09 1.3 3.3c.16.21 2.25 3.43 5.45 4.81.76.33 1.36.53 1.82.67.77.24 1.46.21 2.01.13.61-.09 1.9-.78 2.16-1.53.27-.75.27-1.4.19-1.53-.08-.13-.29-.21-.61-.37Z"/></svg>
    </a>

    <script is:inline src="/js/sitio.js" defer></script>
    {galerias && <script is:inline src="https://cdn.jsdelivr.net/npm/swiper@11.1.14/swiper-bundle.min.js" defer></script>}
    {galerias && <script is:inline src="/js/galerias.js" defer></script>}
  </body>
</html>
